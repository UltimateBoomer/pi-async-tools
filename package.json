{
  "name": "pi-async-tools",
  "version": "0.1.0",
  "description": "One async tool for pi: run any callable tool in the background and get its result later as a message, with the same hooks, sandbox and permission checks.",
  "keywords": [
    "pi-package",
    "async",
    "background"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UltimateBoomer/pi-async-tools.git"
  },
  "homepage": "https://github.com/UltimateBoomer/pi-async-tools",
  "type": "module",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  }
}
